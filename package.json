{
  "name": "skillswap-monorepo",
  "version": "1.0.0",
  "description": "SkillSwap — Exchange Skills, Not Money (Web, Mobile & API Monorepo)",
  "private": true,
  "workspaces": [
    "server",
    "apps/web",
    "apps/mobile",
    "shared"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "seed": "npm --prefix server run seed",
    "build:web": "npm --prefix apps/web run build",
    "start:server": "npm --prefix server run start",
    "install:all": "npm install && npm --prefix server install && npm --prefix apps/web install && npm --prefix apps/mobile install"
  },
  "keywords": [
    "skillswap",
    "skill-exchange",
    "time-credits",
    "peer-to-peer",
    "pwa",
    "expo",
    "react"
  ],
  "author": "SkillSwap Team",
  "license": "MIT"
}
